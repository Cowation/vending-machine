library(knoddy_std) {
    delay_model : table_lookup;
    time_unit : "1ns";
    voltage_unit : "1V";
    current_unit : "1mA";
    pulling_resistance_unit : "1kohm";
    capacitive_load_unit(1, "pf");
    leakage_power_unit : "1nW";

    lu_table_template(delay_template_1x1) {
        variable_1 : input_net_transition;
        variable_2 : total_output_net_capacitance;
        index_1("0.01");
        index_2("0.01");
    }

    power_lut_template(power_template_1x1) {
        variable_1 : input_transition_time;
        index_1("0.01");
    }

    cell(INV_X1) {
        area : 1.0;
        cell_leakage_power : 0.1;

        pin(A) {
            direction : input;
            capacitance : 0.01;
        }

        pin(Y) {
            direction : output;
            function : "!A";
            max_capacitance : 0.20;
            timing() {
                related_pin : "A";
                timing_sense : negative_unate;
                cell_rise(delay_template_1x1) { values("0.03"); }
                cell_fall(delay_template_1x1) { values("0.02"); }
                rise_transition(delay_template_1x1) { values("0.01"); }
                fall_transition(delay_template_1x1) { values("0.01"); }
            }
        }
    }

    cell(BUF_X1) {
        area : 1.0;
        cell_leakage_power : 0.1;

        pin(A) {
            direction : input;
            capacitance : 0.01;
        }

        pin(Y) {
            direction : output;
            function : "A";
            max_capacitance : 0.25;
            timing() {
                related_pin : "A";
                timing_sense : positive_unate;
                cell_rise(delay_template_1x1) { values("0.03"); }
                cell_fall(delay_template_1x1) { values("0.03"); }
                rise_transition(delay_template_1x1) { values("0.01"); }
                fall_transition(delay_template_1x1) { values("0.01"); }
            }
        }
    }

    cell(AND2_X1) {
        area : 2.0;
        cell_leakage_power : 0.2;

        pin(A) {
            direction : input;
            capacitance : 0.015;
        }

        pin(B) {
            direction : input;
            capacitance : 0.015;
        }

        pin(Y) {
            direction : output;
            function : "A & B";
            max_capacitance : 0.25;
            timing() {
                related_pin : "A";
                timing_sense : positive_unate;
                cell_rise(delay_template_1x1) { values("0.05"); }
                cell_fall(delay_template_1x1) { values("0.04"); }
                rise_transition(delay_template_1x1) { values("0.02"); }
                fall_transition(delay_template_1x1) { values("0.02"); }
            }
            timing() {
                related_pin : "B";
                timing_sense : positive_unate;
                cell_rise(delay_template_1x1) { values("0.05"); }
                cell_fall(delay_template_1x1) { values("0.04"); }
                rise_transition(delay_template_1x1) { values("0.02"); }
                fall_transition(delay_template_1x1) { values("0.02"); }
            }
        }
    }

    cell(AND3_X1) {
        area : 3.0;
        cell_leakage_power : 0.3;

        pin(A) {
            direction : input;
            capacitance : 0.015;
        }

        pin(B) {
            direction : input;
            capacitance : 0.015;
        }

        pin(C) {
            direction : input;
            capacitance : 0.015;
        }

        pin(Y) {
            direction : output;
            function : "A & B & C";
            max_capacitance : 0.25;
            timing() {
                related_pin : "A";
                timing_sense : positive_unate;
                cell_rise(delay_template_1x1) { values("0.06"); }
                cell_fall(delay_template_1x1) { values("0.05"); }
                rise_transition(delay_template_1x1) { values("0.02"); }
                fall_transition(delay_template_1x1) { values("0.02"); }
            }
            timing() {
                related_pin : "B";
                timing_sense : positive_unate;
                cell_rise(delay_template_1x1) { values("0.06"); }
                cell_fall(delay_template_1x1) { values("0.05"); }
                rise_transition(delay_template_1x1) { values("0.02"); }
                fall_transition(delay_template_1x1) { values("0.02"); }
            }
            timing() {
                related_pin : "C";
                timing_sense : positive_unate;
                cell_rise(delay_template_1x1) { values("0.06"); }
                cell_fall(delay_template_1x1) { values("0.05"); }
                rise_transition(delay_template_1x1) { values("0.02"); }
                fall_transition(delay_template_1x1) { values("0.02"); }
            }
        }
    }

    cell(AND4_X1) {
        area : 4.0;
        cell_leakage_power : 0.4;

        pin(A) {
            direction : input;
            capacitance : 0.015;
        }

        pin(B) {
            direction : input;
            capacitance : 0.015;
        }

        pin(C) {
            direction : input;
            capacitance : 0.015;
        }

        pin(D) {
            direction : input;
            capacitance : 0.015;
        }

        pin(Y) {
            direction : output;
            function : "A & B & C & D";
            max_capacitance : 0.25;
            timing() {
                related_pin : "A";
                timing_sense : positive_unate;
                cell_rise(delay_template_1x1) { values("0.07"); }
                cell_fall(delay_template_1x1) { values("0.06"); }
                rise_transition(delay_template_1x1) { values("0.02"); }
                fall_transition(delay_template_1x1) { values("0.02"); }
            }
            timing() {
                related_pin : "B";
                timing_sense : positive_unate;
                cell_rise(delay_template_1x1) { values("0.07"); }
                cell_fall(delay_template_1x1) { values("0.06"); }
                rise_transition(delay_template_1x1) { values("0.02"); }
                fall_transition(delay_template_1x1) { values("0.02"); }
            }
            timing() {
                related_pin : "C";
                timing_sense : positive_unate;
                cell_rise(delay_template_1x1) { values("0.07"); }
                cell_fall(delay_template_1x1) { values("0.06"); }
                rise_transition(delay_template_1x1) { values("0.02"); }
                fall_transition(delay_template_1x1) { values("0.02"); }
            }
            timing() {
                related_pin : "D";
                timing_sense : positive_unate;
                cell_rise(delay_template_1x1) { values("0.07"); }
                cell_fall(delay_template_1x1) { values("0.06"); }
                rise_transition(delay_template_1x1) { values("0.02"); }
                fall_transition(delay_template_1x1) { values("0.02"); }
            }
        }
    }

    cell(OR2_X1) {
        area : 2.0;
        cell_leakage_power : 0.2;

        pin(A) {
            direction : input;
            capacitance : 0.015;
        }

        pin(B) {
            direction : input;
            capacitance : 0.015;
        }

        pin(Y) {
            direction : output;
            function : "A | B";
            max_capacitance : 0.25;
            timing() {
                related_pin : "A";
                timing_sense : positive_unate;
                cell_rise(delay_template_1x1) { values("0.06"); }
                cell_fall(delay_template_1x1) { values("0.04"); }
                rise_transition(delay_template_1x1) { values("0.02"); }
                fall_transition(delay_template_1x1) { values("0.02"); }
            }
            timing() {
                related_pin : "B";
                timing_sense : positive_unate;
                cell_rise(delay_template_1x1) { values("0.06"); }
                cell_fall(delay_template_1x1) { values("0.04"); }
                rise_transition(delay_template_1x1) { values("0.02"); }
                fall_transition(delay_template_1x1) { values("0.02"); }
            }
        }
    }

    cell(NAND2_X1) {
        area : 2.0;
        cell_leakage_power : 0.2;

        pin(A) {
            direction : input;
            capacitance : 0.015;
        }

        pin(B) {
            direction : input;
            capacitance : 0.015;
        }

        pin(Y) {
            direction : output;
            function : "!(A & B)";
            max_capacitance : 0.25;
            timing() {
                related_pin : "A";
                timing_sense : negative_unate;
                cell_rise(delay_template_1x1) { values("0.05"); }
                cell_fall(delay_template_1x1) { values("0.04"); }
                rise_transition(delay_template_1x1) { values("0.02"); }
                fall_transition(delay_template_1x1) { values("0.02"); }
            }
            timing() {
                related_pin : "B";
                timing_sense : negative_unate;
                cell_rise(delay_template_1x1) { values("0.05"); }
                cell_fall(delay_template_1x1) { values("0.04"); }
                rise_transition(delay_template_1x1) { values("0.02"); }
                fall_transition(delay_template_1x1) { values("0.02"); }
            }
        }
    }

    cell(NOR2_X1) {
        area : 2.0;
        cell_leakage_power : 0.2;

        pin(A) {
            direction : input;
            capacitance : 0.015;
        }

        pin(B) {
            direction : input;
            capacitance : 0.015;
        }

        pin(Y) {
            direction : output;
            function : "!(A | B)";
            max_capacitance : 0.25;
            timing() {
                related_pin : "A";
                timing_sense : negative_unate;
                cell_rise(delay_template_1x1) { values("0.06"); }
                cell_fall(delay_template_1x1) { values("0.04"); }
                rise_transition(delay_template_1x1) { values("0.02"); }
                fall_transition(delay_template_1x1) { values("0.02"); }
            }
            timing() {
                related_pin : "B";
                timing_sense : negative_unate;
                cell_rise(delay_template_1x1) { values("0.06"); }
                cell_fall(delay_template_1x1) { values("0.04"); }
                rise_transition(delay_template_1x1) { values("0.02"); }
                fall_transition(delay_template_1x1) { values("0.02"); }
            }
        }
    }

    cell(MUX2_X1) {
        area : 3.0;
        cell_leakage_power : 0.3;

        pin(A) {
            direction : input;
            capacitance : 0.015;
        }

        pin(B) {
            direction : input;
            capacitance : 0.015;
        }

        pin(S) {
            direction : input;
            capacitance : 0.020;
        }

        pin(Y) {
            direction : output;
            function : "(!S & A) | (S & B)";
            max_capacitance : 0.25;
            timing() {
                related_pin : "A";
                timing_sense : positive_unate;
                cell_rise(delay_template_1x1) { values("0.07"); }
                cell_fall(delay_template_1x1) { values("0.06"); }
                rise_transition(delay_template_1x1) { values("0.02"); }
                fall_transition(delay_template_1x1) { values("0.02"); }
            }
            timing() {
                related_pin : "B";
                timing_sense : positive_unate;
                cell_rise(delay_template_1x1) { values("0.07"); }
                cell_fall(delay_template_1x1) { values("0.06"); }
                rise_transition(delay_template_1x1) { values("0.02"); }
                fall_transition(delay_template_1x1) { values("0.02"); }
            }
            timing() {
                related_pin : "S";
                timing_sense : non_unate;
                cell_rise(delay_template_1x1) { values("0.08"); }
                cell_fall(delay_template_1x1) { values("0.08"); }
                rise_transition(delay_template_1x1) { values("0.02"); }
                fall_transition(delay_template_1x1) { values("0.02"); }
            }
        }
    }

    cell(DFF_X1) {
        area : 4.0;
        cell_leakage_power : 0.4;

        ff(IQ, IQN) {
            clocked_on : "CLK";
            next_state : "D";
        }

        pin(CLK) {
            direction : input;
            clock : true;
            capacitance : 0.02;
        }

        pin(D) {
            direction : input;
            capacitance : 0.02;
            timing() {
                related_pin : "CLK";
                timing_type : setup_rising;
                rise_constraint(delay_template_1x1) { values("0.05"); }
                fall_constraint(delay_template_1x1) { values("0.05"); }
            }
            timing() {
                related_pin : "CLK";
                timing_type : hold_rising;
                rise_constraint(delay_template_1x1) { values("0.02"); }
                fall_constraint(delay_template_1x1) { values("0.02"); }
            }
        }

        pin(Q) {
            direction : output;
            function : "IQ";
            max_capacitance : 0.30;
            timing() {
                related_pin : "CLK";
                timing_type : rising_edge;
                timing_sense : non_unate;
                cell_rise(delay_template_1x1) { values("0.10"); }
                cell_fall(delay_template_1x1) { values("0.10"); }
                rise_transition(delay_template_1x1) { values("0.03"); }
                fall_transition(delay_template_1x1) { values("0.03"); }
            }
        }
    }
}
