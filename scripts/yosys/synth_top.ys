# Run from the repository root:
#   yosys -s scripts/yosys/synth_top.ys

read_verilog rtl/controller.v
read_verilog rtl/datapath.v
read_verilog rtl/lut_2to3.v
read_verilog rtl/reg2.v
read_verilog rtl/reg3.v
read_verilog rtl/lt3.v
read_verilog rtl/add3.v
read_verilog rtl/top.v

hierarchy -check -top top

# Keep every RTL module boundary while allowing the synthesis passes below to
# optimize and technology-map the logic inside each module independently.
setattr -mod -set keep_hierarchy 1 controller datapath lut_2to3 reg2 reg3 lt3 add3

proc

# Preserve the controller equations as written by extracting their RTL-derived
# operator trees into the matching standard cells before logic optimization.
opt_merge controller
extract -map lib/knoddy_std/verilog/knoddy_std.v controller

opt
fsm
opt
memory
opt

dffunmap
opt
techmap
opt

dfflibmap -liberty lib/knoddy_std/liberty/knoddy_std.lib
abc -exe yosys-abc -liberty lib/knoddy_std/liberty/knoddy_std.lib

read_liberty -lib lib/knoddy_std/liberty/knoddy_std.lib
delete t:$scopeinfo
opt_clean
check
stat -liberty lib/knoddy_std/liberty/knoddy_std.lib

write_verilog -noattr -noexpr -simple-lhs build/yosys/top_gate.v
